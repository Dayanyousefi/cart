# =============================================================================
# INVITÉ / Eyvan — International Luxury Digital Invitation SaaS Platform
# Environment Configuration Template (.env.example)
# =============================================================================

NODE_ENV="development"
PORT="3000"
APP_URL="http://localhost:3000"

# Cloud SQL PostgreSQL (Injected by AI Studio Runtime)
SQL_HOST="/cloudsql/instance"
SQL_DB_NAME="invite_db"
SQL_USER="app_user"
SQL_PASSWORD="placeholder_password"
SQL_ADMIN_USER="admin_user"
SQL_ADMIN_PASSWORD="placeholder_admin_password"

# Localization & Pricing Defaults
DEFAULT_LOCALE="fa-IR"
DEFAULT_TIMEZONE="Asia/Tehran"
DEFAULT_BASE_INVITATION_PRICE_TOMAN="50000"

# Gemini API (Optional AI-Assisted Invitation Copywriting)
GEMINI_API_KEY="MY_GEMINI_API_KEY"
