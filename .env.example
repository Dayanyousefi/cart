# =============================================================================
# تنظیمات محیطی پلتفرم دعوتنامه دیجیتال (Eyvan Invitation SaaS Platform)
# هشدار امنیتی: هیچ کلید واقعی یا رمز عبوری را در این فایل قرار ندهید.
# =============================================================================

# --- ۱. تنظیمات پایه برنامه ---
NODE_ENV="development"
PORT="3000"
APP_NAME="Eyvan Digital Invitation Platform"
APP_URL="http://localhost:3000"
PUBLIC_INVITATION_BASE_PATH="/i"
DEFAULT_TIMEZONE="Asia/Tehran"
DEFAULT_LOCALE="fa-IR"
BASE_INVITATION_PRICE_TOMAN="50000"

# --- ۲. دیتابیس اصلی (PostgreSQL) ---
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/invitation_saas?schema=public"
DB_POOL_MIN="2"
DB_POOL_MAX="20"
DB_SSL_ENABLED="false"

# --- ۳. کش و صف پردازش پسزمینه (Redis & BullMQ) ---
REDIS_ENABLED="false"
REDIS_URL="redis://localhost:6379/0"
QUEUE_DRIVER="in-memory" # گزینهها: in-memory (محیط توسعه/AI Studio) | bullmq (محیط Production VPS)

# --- ۴. احراز هویت و امنیت نشستها ---
JWT_ACCESS_SECRET="REPLACE_WITH_64_BYTE_HEX_SECRET_IN_ENV"
JWT_REFRESH_SECRET="REPLACE_WITH_64_BYTE_HEX_SECRET_IN_ENV"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"
COOKIE_SECRET="REPLACE_WITH_COOKIE_SIGNING_SECRET"
COOKIE_SECURE="false" # در محیط Production دارای HTTPS باید true باشد
BCRYPT_SALT_ROUNDS="12"
RATE_LIMIT_WINDOW_MS="60000"
RATE_LIMIT_MAX_REQUESTS="100"
AUTH_RATE_LIMIT_MAX_ATTEMPTS="5"

# --- ۵. درگاه پرداخت ایرانی (Adapter Pattern) ---
PAYMENT_GATEWAY_PROVIDER="mock" # گزینهها: mock | zarinpal | zibal | idpay | nextpay
PAYMENT_MERCHANT_ID="00000000-0000-0000-0000-000000000000"
PAYMENT_CALLBACK_URL="http://localhost:3000/api/v1/payments/callback"
PAYMENT_SANDBOX_MODE="true"

# --- ۶. ذخیرهسازی فایل و رسانه (S3 / MinIO / Local Adapter) ---
STORAGE_DRIVER="local" # گزینهها: local | s3
STORAGE_LOCAL_DIR="./uploads"
S3_ENDPOINT="https://s3.ir-thr-at1.arvanstorage.ir"
S3_BUCKET="invitation-media"
S3_REGION="ir-thr-at1"
S3_ACCESS_KEY_ID="YOUR_S3_ACCESS_KEY"
S3_SECRET_ACCESS_KEY="YOUR_S3_SECRET_KEY"
CDN_BASE_URL="https://cdn.example.ir"
MAX_UPLOAD_SIZE_BYTES="5242880" # ۵ مگابایت

# --- ۷. سرویس پیامک و ایمیل (اطلاعرسانی و OTP) ---
SMS_PROVIDER="mock" # گزینهها: mock | kavenegar | melipayamak | sms_ir
SMS_API_KEY="YOUR_SMS_PROVIDER_API_KEY"
SMTP_HOST="smtp.example.ir"
SMTP_PORT="587"
SMTP_USER="noreply@example.ir"
SMTP_PASS="YOUR_SMTP_PASSWORD"

# --- ۸. متغیرهای اختصاصی محیط Google AI Studio ---
GEMINI_API_KEY="MY_GEMINI_API_KEY"
